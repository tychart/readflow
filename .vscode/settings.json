{
  // ── Formatting / linting (Biome) ─────────────────────────────
  // Biome is the only JS/TS/JSON/YAML formatter and linter in this repo
  // (biome.jsonc at the repo root). The extension is recommended in
  // .vscode/extensions.json; these settings are what make saving a file
  // equivalent to `bun run lint:fix` in web/.
  "biome.enabled": true,
  "biome.lsp.bin": "/home/tychart/projects/readflow/web/node_modules/.bin/biome",
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "[typescript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[typescriptreact]": { "editor.defaultFormatter": "biomejs.biome" },
  "[javascript]": { "editor.defaultFormatter": "biomejs.biome" },
  "[json]": { "editor.defaultFormatter": "biomejs.biome" },
  "[jsonc]": { "editor.defaultFormatter": "biomejs.biome" },
  "[css]": { "editor.defaultFormatter": "biomejs.biome" },
  "[yaml]": { "editor.defaultFormatter": "biomejs.biome" },

  "pendant.autoGenerateSessionNames": false,
  "pendant.showThinking": true,

  // ── Python test discovery (server/) ───────────────────────────
  // The repo root is the workspace, but the Python project lives in
  // server/ (pyproject.toml, .venv, tests/). Point the Python
  // extension at that venv and run pytest from server/ so
  // [tool.pytest.ini_options] (pythonpath = ["."], testpaths) applies.
  "python.defaultInterpreterPath": "${workspaceFolder}/server/.venv/bin/python",
  "python.testing.cwd": "${workspaceFolder}/server",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"]
}
