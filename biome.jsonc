{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",

  // Biome owns formatting, linting and import organization for the repo's
  // JS/TS/JSON/YAML surface. The binary is installed in web/ (the only JS
  // package, so `bun install` stays there), while this config sits at the repo
  // root so root-level JSON/YAML is held to the same rules. That is why the web
  // scripts run `biome ... ..` from web/.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "includes": [
      "web/**",
      "biome.jsonc",
      "package.json",
      "compose.yml",
      "compose.cpu.yml",
      ".github/**/*.yml",
      // Not source: bun owns the lockfile, tsbuildinfo is generated (and one of
      // them is unfortunately tracked), and Biome's markdown formatter is still
      // experimental, so prose is out of scope.
      "!**/*.md",
      // Image assets are files, not DOM: noSvgWithoutTitle only makes sense for
      // inline JSX, where the label comes from the surrounding UI.
      "!web/public",
      "!web/src/assets",
      "!web/bun.lock",
      "!web/**/*.tsbuildinfo",
      "!web/dist",
      "!web/coverage",
      "!web/test-results",
      "!web/playwright-report"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },

  // Tailwind v4 adds at-rules (@custom-variant, @theme) that plain CSS parsing
  // rejects. The Tailwind domain below uses this parser setting too.
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "error",
          "options": {
            // eslint-plugin-react-hooks never reported extra dependencies and
            // several effects here intentionally list values they only use as
            // invalidation keys (canvas backing pixels, stream anchor). Missing
            // dependencies are still errors; needless churn is not.
            "reportUnnecessaryDependencies": false
          }
        }
      }
    },
    "domains": {
      "react": "recommended",
      "test": "recommended",
      "playwright": "recommended",
      "tailwind": "recommended"
    }
  },

  "overrides": [
    {
      // Test harnesses mount bare <audio> elements (no captions apply to
      // synthesized speech), wrap hooks in local factory helpers on purpose, and
      // index fixed-length fixtures with `!`. None of those are the mistakes
      // these rules exist to catch, and the production code keeps them on.
      "includes": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "web/setupTests.ts",
        "web/e2e/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "useMediaCaption": "off"
          },
          "correctness": {
            "noComponentHookFactories": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
