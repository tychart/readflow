# Copy to `.env` (repo root, gitignored) for local overrides. That one file is
# read by compose, by `scripts/dev.sh` and by Vite.

# ── Images ────────────────────────────────────
# Published image tag to pull. `latest` tracks main; pin a release like `1.2.3`.
# Flash users: ghcr.io/tychart/readflow-api:<tag>-flash
READFLOW_API_IMAGE=ghcr.io/tychart/readflow-api:latest
READFLOW_WEB_IMAGE=ghcr.io/tychart/readflow-web:latest

# Local build selection (only used by `compose up --build`):
#   READFLOW_TARGET=cuda  + READFLOW_FLASH=1  -> flash-attn image
#   READFLOW_TARGET=cpu                       -> CPU-only image (compose.cpu.yml)
READFLOW_TARGET=cuda
READFLOW_FLASH=0

# ── Runtime ───────────────────────────────────
# Host port for the web UI.
READFLOW_PORT=8080

# qwen (real, needs a GPU/CPU) or fake (no model, for UI testing).
READFLOW_TTS_PROVIDER=qwen

READFLOW_SCHEDULER_AUTOSTART=true
READFLOW_TEMP_DIR_NAME=readflow

# ── Media ─────────────────────────────────────
# Where rendered audio lives. Unset = the system temp dir (fine for dev). The
# container images mount a volume here, because a container's /tmp disappears on
# recreate and the rendered audio must outlive it.
# READFLOW_MEDIA_DIR=/app/server/.media

# ── Database ──────────────────────────────────
# Postgres for jobs, folders, progress, sessions. `scripts/dev.sh` starts a
# local container when this URL points at loopback and nothing is listening;
# `make db-up` does the same by hand. Leave it unset (or run dev.sh --memory)
# to keep every row in process memory, which is the test/dev adapter.
# DATABASE_URL=postgresql+psycopg://readflow:readflow@127.0.0.1:5432/readflow
# Credentials for the container `make db-up` / compose start. They are read by
# the postgres image on first initialisation only.
POSTGRES_USER=readflow
POSTGRES_PASSWORD=readflow
POSTGRES_DB=readflow
# Image used by compose and by `make db-up` / `dev.sh` for the local container.
READFLOW_PG_IMAGE=docker.io/library/postgres:18

# ── Auth / security ───────────────────────────
# auto: Secure only when the request arrived over HTTPS (honours
# X-Forwarded-Proto behind a reverse proxy). always/never force it.
READFLOW_COOKIE_SECURE=auto
# Extra origins allowed to make state-changing requests: comma-separated
# scheme://host[:port]. HOST_URL below is added automatically by the server.
# READFLOW_ALLOWED_ORIGINS=https://readflow.example.com

# ── Backups ───────────────────────────────────
# Directory `scripts/backup.sh` writes dumps into, and how many to keep.
BACKUP_DIR=./backups
BACKUP_RETENTION=14

# ── Hugging Face (optional) ───────────────────
# Authenticated / faster model downloads. Weights live in the `hf-cache` volume.
# HF_TOKEN=

# ── Local dev ─────────────────────────────────
# Hostname a reverse proxy reaches the Vite dev server on. Vite rejects Host
# headers it was not told about; loopback, *.localhost and IPs need nothing.
# HOST_URL=readflow.example.com
