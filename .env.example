# Copy to `.env` to override compose.yml defaults.

# ── Images ────────────────────────────────────
# Published image tag to pull. `latest` tracks main; pin a release like `1.2.3`.
# Flash users: ghcr.io/tychart/readflow-api:<tag>-flash
READFLOW_API_IMAGE=ghcr.io/tychart/readflow-api:latest
READFLOW_WEB_IMAGE=ghcr.io/tychart/readflow-web:latest

# Local build selection (only used by `compose up --build`):
#   READFLOW_TARGET=cuda  + READFLOW_FLASH=1  -> flash-attn image
#   READFLOW_TARGET=cpu                       -> CPU-only image (compose.cpu.yml)
READFLOW_TARGET=cuda
READFLOW_FLASH=0

# ── Runtime ───────────────────────────────────
# Host port for the web UI.
READFLOW_PORT=8080

# qwen (real, needs a GPU/CPU) or fake (no model, for UI testing).
READFLOW_TTS_PROVIDER=qwen

READFLOW_SCHEDULER_AUTOSTART=true
READFLOW_TEMP_DIR_NAME=readflow

# ── Hugging Face (optional) ───────────────────
# Authenticated / faster model downloads. Weights live in the `hf-cache` volume.
# HF_TOKEN=
